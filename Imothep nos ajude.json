      "name": "Notas da Campanha",
      "style": "@controls {\n  bottom {\n    filter {\n      target: connection;\n      by: \"connection type\";\n      as: labels;\n      multiple: true;\n      default: show-all;\n    }\n  }\n\n  top {\n    filter {\n      target: element;\n      by: \"element type\";\n      as: labels;\n      multiple: true;\n      default: show-all;\n    }\n  }\n}\n\n@settings {\n  template: stakeholder;\n  theme: dark;\n  layout: force;\n  connection-color: #a7a7a7;\n  renderer: canvas;\n  layout-preset: hairball;\n  element-scale: scale(\"degree\", 0.5, 4);\n}\n\n/* Personagem */\nelement[\"element type\"=\"PC\"] {\n  color: #54a159;\n}\n\n/* NPC */\nelement[\"element type\"=\"NPC\"] {\n  color: #6aaed6;\n}\n\n/* Grupo */\nelement[\"element type\"=\"Grupo\"] {\n  color: #f67c49;\n  shape: pentagon;\n}\n\n/* Local */\nelement[\"element type\"=\"Local\"] {\n  color: #97bd8a;\n  shape: rectangle;\n}\n\n/* Monstro / Criatura / Boss */\nelement[\"element type\"=\"Monstro\"] {\n  color: #a80707;\n  shape: hexagon;\n}\n\n/* Deus / Patrono / Entidade */\nelement[\"element type\"=\"Entidade\"] {\n  color: #fff1a5;\n  shape: circle;\n}\n\n/* Item / Artefato */\nelement[\"element type\"=\"Item\"] {\n  color: #fffc00;\n  shape: diamond;\n}\n\n/* Evento */\nelement[\"element type\"=\"Evento\"] {\n  color: white;\n  shape: circle;\n}\n\n/* Condição */\nelement[\"element type\"=\"Condição\"] {\n  color: purple;\n  shape: circle;\n}\n\n\n/* Líder */\nconnection[\"connection type\"=\"Lider\"] {\n  color: #f67c49;\n}\n\n/* Membro */\nconnection[\"connection type\"=\"Membro\"] {\n  color: #f67c49;\n  style: dashed;\n}\n\n/* Parente */\nconnection[\"connection type\"=\"Parente\"] {\n  color: #3596c0;\n}\n\n/* Pertence */\nconnection[\"connection type\"=\"Pertence\"] {\n  color: #3596c0;\n  style: dashed;\n}\n\n/* Amigo */\nconnection[\"connection type\"=\"Amigo\"] {\n  color: #00682a;\n}\n\n/* Inimigo */\nconnection[\"connection type\"=\"Inimigo\"] {\n  color: #FF0000;\n}\n\n/* Patrono */\nconnection[\"connection type\"=\"Patrono\"] {\n  color: #74c89e;\n}\n\n/* Devoto */\nconnection[\"connection type\"=\"Devoto\"] {\n  color: #74c89e;\n  style: dashed;\n}\n\n/* Comerciante */\nconnection[\"connection type\"=\"Comerciante\"] {\n  color: #c77dff;\n  style: dotted;\n}\n\n/* Rumor */\nconnection[\"connection type\"=\"Rumor\"] {\n  color: #9d4edd;\n  style: dashed;\n}\n\n/* Portador */\nconnection[\"connection type\"=\"Portador\"] {\n  color: #f2c94c;\n}\n\n/* Afeta */\nconnection[\"connection type\"=\"Afeta\"] {\n  color: #ff006e;\n  style: dashed;\n}\n\n/* Ocorreu em */\nconnection[\"connection type\"=\"Ocorreu em\"] {\n  color: #00b4d8;\n}\n\n/* Envolvido */\nconnection[\"connection type\"=\"Envolvido\"] {\n  color: #ff9f1c;\n  style: dashed;\n}\n\n/* Origem */\nconnection[\"connection type\"=\"Origem\"] {\n  color: #8d99ae;\n  style: dotted;\n}\n\n/* Conexão Não Classificada */\nconnection[\"connection type\"=\"Conexão Não Classificada\"] {\n  color: #ffffff;\n  style: dashed;\n}\n\nelement[\"status\"=\"Morto\"], element[\"status\"=\"Morto?\"] {\n  opacity: 0.3;\n  border-width: 5;\n  border-color: black;\n  label: \"{{label}} (Morto)\";\n}\n\nelement[\"status\"=\"Destruido\"], element[\"status\"=\"Destruido?\"] {\n  opacity: 0.5;\n  border-width: 5;\n  border-color: Orange;\n  label: \"{{label}} (Destruido)\";\n}\n\nelement[\"status\"=\"Desconhecido\"], element[\"status\"=\"Desconhecido?\"] {\n  opacity: 0.7;\n  border-width: 5;\n  border-color: Green;\n  label: \"{{label}} (Desconhecido)\";\n}\n\n"
